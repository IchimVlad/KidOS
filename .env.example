# Copiază în .env.local. Valorile reale vin din `neon env pull`.
# Nu pune secrete în acest fișier.
# DATABASE_URL — conexiune pooled pentru interogările aplicației.
DATABASE_URL=
# DATABASE_URL_UNPOOLED — conexiune directă pentru migrări Prisma și unelte DB.
DATABASE_URL_UNPOOLED=
# Used only when a user explicitly requests medical-information extraction from a consultation.
# Keep this server-side key secret; never expose it with a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=
